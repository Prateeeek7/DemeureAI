# Copy to backend/.env and fill in. Never commit the real file.

# --- Runtime ------------------------------------------------------------------
# "production" enforces a strong SECRET_KEY and non-demo PINs, disables demo data and API docs.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# AES-256-GCM key for resident personal data (phone, guardian, address, health). Required in production.
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it safe: if it is lost, encrypted fields cannot be read. Unset in development = derived from SECRET_KEY.
DATA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# Comma-separated origins allowed to call the API cross-origin (not needed when served same-origin).
CORS_ORIGINS=
# Where the SQLite database and local uploads live (mock mode).
DATA_DIR=
MAX_UPLOAD_MB=5
# Seed demo records (on by default outside production).
SEED_DEMO_DATA=
# Set false to skip loading the embedding model (the assistant then returns 503).
RAG_ENABLED=true
LOG_LEVEL=INFO

# --- Credentials ------------------------------------------------------------------
# 12-digit staff PINs (dashes optional). Required in production; demo PINs are refused there.
CAMPUS_ADMIN_PIN=
HOSTEL_ADMIN_PIN=
MESS_MANAGER_PIN=
# Student accounts: email|access code|full name|room|guardian email ; separated by semicolons.
STUDENT_ACCOUNTS=

# --- AI handbook assistant (optional; without a key, raw retrieved policy text is returned) --
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AWS (optional; without keys the app runs in local mock mode) -----------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=demeure-assets
AWS_SES_SENDER=
